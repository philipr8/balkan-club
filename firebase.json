{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "public": "docs",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/text.txt"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "{/,/exec/,/**/*.@(html|js|css)}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/images/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "site": "absqu"
    },
    {
      "site": "absqu-exec",
      "public": "redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://absqu.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://absqu.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}
